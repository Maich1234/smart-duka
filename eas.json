{
  "cli": {
    "version": ">= 16.20.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": {
        "DUQANA_APK_TARGET": "phones"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview-arm64": {
      "extends": "preview",
      "env": {
        "DUQANA_APK_TARGET": "arm64"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
